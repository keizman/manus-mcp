# =============================================================================
# Manus MCP Configuration
# =============================================================================

# --- Manus API (Required) ---
# Your Manus API key. Get it from: https://manus.im/settings
MANUS_API_KEY=your-manus-api-key-here

# Manus API base URL (default: https://api.manus.ai)
# MANUS_API_BASE_URL=https://api.manus.ai

# --- Server Configuration ---
LOG_LEVEL=INFO

# --- Legacy: Local Browser (optional, for backward compatibility) ---
# These settings are for the local browser-use integration.
# The new Manus API-based tools use the "My Browser" connector instead.
# BROWSER_HEADLESS=false
# CHROME_INSTANCE_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"

# --- Legacy: Local Search (optional, for backward compatibility) ---
# GOOGLE_SEARCH_MAX_RESULTS=10
